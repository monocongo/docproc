{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docproc:phase0-lock-inventory-v1",
  "title": "Phase 0 base and primary-candidate lock inventory payload",
  "type": "object",
  "required": [
    "payload_version",
    "payload_schema_digest",
    "evidence_id",
    "kind",
    "source_commit",
    "policy_digest",
    "source_decisions",
    "inventory",
    "failures",
    "exclusions",
    "reviewed_exceptions",
    "content_classification",
    "publication_disposition"
  ],
  "properties": {
    "payload_version": {"const": "docproc-evidence-payload-v1"},
    "payload_schema_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evidence_id": {"const": "EVID-LOCK-INVENTORY-001"},
    "kind": {"const": "lock-inventory"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_decisions": {"type": "array", "minItems": 1},
    "inventory": {"type": "array", "minItems": 1},
    "failures": {"type": "array"},
    "exclusions": {"type": "array"},
    "reviewed_exceptions": {"type": "array"},
    "content_classification": {"const": "metadata-only"},
    "publication_disposition": {"const": "private-only"}
  },
  "additionalProperties": false
}
